<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
        <CompatibilityMode Value="True"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <AutoCreateForms Value="False"/>
      <Title Value="Cheat Engine 7.3"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
        <ExecutionLevel Value="requireAdministrator"/>
        <TextName Value="Cheat Engine"/>
        <TextDesc Value="Scripting language and tools"/>
      </XPManifest>
      <Icon Value="0"/>
    </General>
    <i18n>
      <EnableI18N Value="True"/>
      <OutDir Value="../Cheat Engine/bin/languages"/>
    </i18n>
    <VersionInfo>
      <UseVersionInfo Value="True"/>
      <AutoIncrementBuild Value="True"/>
      <MajorVersionNr Value="7"/>
      <MinorVersionNr Value="2"/>
      <BuildNr Value="7077"/>
      <StringTable CompanyName="Cheat Engine" FileDescription="Cheat Engine" ProductVersion="7.2"/>
    </VersionInfo>
    <BuildModes Count="1">
      <Item1 Name="Release linux x64_86" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages Count="6">
      <Item1>
        <PackageName Value="DebuggerIntf"/>
      </Item1>
      <Item2>
        <PackageName Value="CodeTools"/>
      </Item2>
      <Item3>
        <PackageName Value="FCL"/>
      </Item3>
      <Item4>
        <PackageName Value="IDEIntf"/>
      </Item4>
      <Item5>
        <PackageName Value="SynEdit"/>
      </Item5>
      <Item6>
        <PackageName Value="LCL"/>
      </Item6>
    </RequiredPackages>
    <Units Count="5">
      <Unit0>
        <Filename Value="cheatengineLinux.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit0>
      <Unit1>
        <Filename Value="fuckitcopypastedcode/anchoreditor.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="AnchorEditor"/>
      </Unit1>
      <Unit2>
        <Filename Value="linux/linuxex.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="LinuxEx"/>
      </Unit2>
      <Unit3>
        <Filename Value="fuckitcopypastedcode/environmentopts.pp"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="EnvironmentOpts"/>
      </Unit3>
      <Unit4>
        <Filename Value="fuckitcopypastedcode/idetranslations.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="IDETranslations"/>
      </Unit4>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="bin/cheatengine-$(TargetCPU)"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="VEHDebug;dbk32;lua;jvdesign;betterControls;$(LazarusDir)/ide;linux"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Parsing>
      <Style Value="1"/>
      <SyntaxOptions>
        <SyntaxMode Value="Delphi"/>
      </SyntaxOptions>
    </Parsing>
    <CodeGeneration>
      <SmartLinkUnit Value="True"/>
      <TargetCPU Value="x86_64"/>
      <TargetOS Value="linux"/>
      <Optimizations>
        <OptimizationLevel Value="3"/>
      </Optimizations>
    </CodeGeneration>
    <Linking>
      <Debugging>
        <StripSymbols Value="True"/>
        <UseExternalDbgSyms Value="True"/>
      </Debugging>
      <LinkSmart Value="True"/>
    </Linking>
    <Other>
      <Verbosity>
        <ShowNotes Value="False"/>
        <ShowHints Value="False"/>
      </Verbosity>
      <WriteFPCLogo Value="False"/>
      <CustomOptions Value="-dbenchmarkps
-dcemain
-dNDEBUG
-dDBVMFORAMDISWORKING"/>
    </Other>
  </CompilerOptions>
  <Debugging>
    <Exceptions Count="3">
      <Item1>
        <Name Value="EAbort"/>
      </Item1>
      <Item2>
        <Name Value="ECodetoolError"/>
      </Item2>
      <Item3>
        <Name Value="EFOpenError"/>
      </Item3>
    </Exceptions>
  </Debugging>
</CONFIG>
